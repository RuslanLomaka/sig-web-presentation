{
  "name": "sintelligence-site",
  "private": true,
  "description": "Checks for the Sintelligence website. Nothing here is deployed; the site is dist/.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "html-validate": "11.21.0",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts && git config core.hooksPath .githooks",
    "check": "node tools/check.mjs",
    "check:fast": "node tools/check.mjs --fast",
    "standard:accept": "node tools/check.mjs --accept --only layout,standard",
    "stamp": "node tools/stamp.mjs",
    "preview": "node tools/preview.mjs",
    "shots": "node tools/shots.mjs",
    "selftest": "node tools/selftest.mjs",
    "ship": "tools/ship.sh"
  }
}
